print("========== DELTA CRYPTO DIAGNOSTIC ==========")

local function show(name, value)
    print(name .. " = " .. type(value))
end

local crypt = rawget(_G, "crypt")

print("")
print("---- CRYPTO ----")
show("crypt", crypt)

if type(crypt) == "table" then
    local names = {
        "signcreate",
        "sign_create",
        "signkeygen",
        "sign_keygen",
        "sign",
        "signopen",
        "sign_open",
        "generatebytes",
        "random",
        "hash",
        "base64encode",
        "base64decode",
        "hexencode",
        "hexdecode"
    }

    for _, name in ipairs(names) do
        show("crypt." .. name, crypt[name])
    end

    local keygen =
        crypt.signcreate
        or crypt.sign_create
        or crypt.signkeygen
        or crypt.sign_keygen

    print("")
    print("---- KEY GENERATION ----")

    if type(keygen) == "function" then
        local ok, a, b, c = pcall(keygen)

        print("keygen success = " .. tostring(ok))

        if ok then
            print("return #1 type = " .. type(a))
            print("return #1 = " .. tostring(a))

            print("return #2 type = " .. type(b))
            print("return #2 = " .. tostring(b))

            print("return #3 type = " .. type(c))
            print("return #3 = " .. tostring(c))

            print("")
            print("---- SIGN TEST ----")

            if type(crypt.sign) == "function" then
                local ok1, result1 = pcall(function()
                    return crypt.sign(
                        "CLIENT_INSPECTOR_TEST",
                        b
                    )
                end)

                print("sign(message,key) success = " .. tostring(ok1))
                print("result = " .. tostring(result1))

                local ok2, result2 = pcall(function()
                    return crypt.sign(
                        b,
                        "CLIENT_INSPECTOR_TEST"
                    )
                end)

                print("sign(key,message) success = " .. tostring(ok2))
                print("result = " .. tostring(result2))
            else
                print("crypt.sign is not available.")
            end
        else
            print("keygen error = " .. tostring(a))
        end
    else
        print("NO SIGNING KEY GENERATION FUNCTION FOUND.")
    end
else
    print("crypt table is not available.")
end

print("")
print("---- HWID ----")

local hwidFn =
    rawget(_G, "gethwid")
    or rawget(_G, "get_hwid")
    or rawget(_G, "get_user_identifier")

show("gethwid", hwidFn)

if type(hwidFn) == "function" then
    local ok, value = pcall(hwidFn)

    print("HWID call success = " .. tostring(ok))

    if ok then
        local hwid = tostring(value)

        print("HWID type = " .. type(value))
        print("HWID length = " .. tostring(#hwid))

        -- Don't reveal the HWID itself.
        print("HWID prefix = " .. hwid:sub(1, 6) .. "...")
    end
end

print("")
print("---- FILE APIs ----")

show("isfile", rawget(_G, "isfile"))
show("readfile", rawget(_G, "readfile"))
show("writefile", rawget(_G, "writefile"))
show("delfile", rawget(_G, "delfile"))
show("makefolder", rawget(_G, "makefolder"))

print("")
print("========== END DIAGNOSTIC ==========")
